# Application
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN_DAYS=7

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=tiffinbd

# Internal service auth (tiffinbd-order → tiffinbd-backend)
INTERNAL_SERVICE_TOKEN=change-me-internal-token

# Mock Branches API (replace with real branch service URL when available)
BRANCHES_API_URL=http://localhost:3005

